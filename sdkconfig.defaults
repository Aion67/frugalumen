# Build defaults for the Wokwi ESP32 DevKit-C board.
# idf.py reads this file when sdkconfig does not exist yet.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# 1 ms tick so vTaskDelay(pdMS_TO_TICKS(10)) really means 10 ms
CONFIG_FREERTOS_HZ=1000

# Long file names are not needed; keeps FATFS small
CONFIG_FATFS_LFN_NONE=y

# Keep boot output short so the console menu is easy to find
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
